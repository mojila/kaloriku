<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ backup/transfer rules. Backups are opt-in per domain rather than
  "everything by default", so what is restored is a deliberate decision:
  the Room database (kaloriku.db plus its -wal/-shm siblings) and the
  DataStore preferences file.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
