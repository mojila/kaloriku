<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ backup/transfer rules, mirroring the phone app. The watch is a
  standalone app with its own kaloriku.db and DataStore file.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
